<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Đăng ký · HCMUTE Shop</title><script src="${pageContext.request.contextPath}/assets/js/theme.js"></script><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/dashboard.css"></head>
<body class="auth-body"><button class="icon-button theme-toggle auth-theme-toggle" data-theme-toggle type="button" aria-label="Chuyển chế độ giao diện"><span class="theme-symbol theme-symbol-sun" aria-hidden="true">☀</span><span class="theme-symbol theme-symbol-moon" aria-hidden="true">☾</span></button><div class="auth-shell"><aside class="auth-aside"><a class="auth-brand" href="${pageContext.request.contextPath}/home"><img class="brand-logo" src="${pageContext.request.contextPath}/assets/images/logo.jpg" alt="Logo HCM-UTE">HCMUTE Shop</a><div class="auth-highlight"><p class="hero-eyebrow">Tạo tài khoản</p><h2>Đăng ký an toàn với xác nhận OTP.</h2><p>Sau khi gửi biểu mẫu, hệ thống gửi mã gồm 6 chữ số đến email để kích hoạt tài khoản.</p></div><span class="auth-copy">OTP có hiệu lực trong 5 phút</span></aside>
<main class="auth-main"><div class="auth-card wide"><h1>Tạo tài khoản</h1><p class="auth-lead">Điền thông tin chính xác để nhận mã kích hoạt qua email.</p><c:if test="${not empty error}"><div class="alert alert-error" style="margin-bottom:14px"><c:out value="${error}"/></div></c:if>
<form class="auth-form" action="${pageContext.request.contextPath}/register" method="post"><div class="auth-form-row"><div class="field"><label for="fullname">Họ và tên</label><input class="form-control" id="fullname" name="fullname" value="<c:out value='${fullname}'/>" minlength="2" maxlength="100" required autocomplete="name"></div><div class="field"><label for="phone">Số điện thoại</label><input class="form-control" id="phone" name="phone" value="<c:out value='${phone}'/>" pattern="^(0|\+84)[35789][0-9]{8}$" required autocomplete="tel" placeholder="0912345678"></div></div>
<div class="auth-form-row"><div class="field"><label for="username">Tên đăng nhập</label><input class="form-control" id="username" name="username" value="<c:out value='${username}'/>" pattern="[A-Za-z0-9_]{4,50}" required autocomplete="username" placeholder="nguyenvana"></div><div class="field"><label for="email">Email nhận OTP</label><input class="form-control" id="email" name="email" type="email" value="<c:out value='${email}'/>" required autocomplete="email" placeholder="name@example.com"></div></div>
<div class="auth-form-row"><div class="field"><label for="password">Mật khẩu</label><input class="form-control" id="password" name="password" type="password" minlength="6" required autocomplete="new-password"></div><div class="field"><label for="confirmPassword">Xác nhận mật khẩu</label><input class="form-control" id="confirmPassword" name="confirmPassword" type="password" minlength="6" required autocomplete="new-password"></div></div>
<button class="btn btn-primary auth-submit" type="submit">Đăng ký và nhận OTP →</button></form><p class="auth-bottom">Đã có tài khoản? <a class="auth-link" href="${pageContext.request.contextPath}/login">Đăng nhập</a></p></div></main></div></body></html>
