<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Xác nhận OTP · HCMUTE Shop</title><script src="${pageContext.request.contextPath}/assets/js/theme.js"></script><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/dashboard.css"></head>
<body class="auth-body"><button class="icon-button theme-toggle auth-theme-toggle" data-theme-toggle type="button" aria-label="Chuyển chế độ giao diện"><span class="theme-symbol theme-symbol-sun" aria-hidden="true">☀</span><span class="theme-symbol theme-symbol-moon" aria-hidden="true">☾</span></button><main class="auth-main" style="min-height:100vh"><div class="auth-card"><a class="auth-brand" style="margin-bottom:34px" href="${pageContext.request.contextPath}/home"><img class="brand-logo" src="${pageContext.request.contextPath}/assets/images/logo.jpg" alt="Logo HCM-UTE">HCMUTE Shop</a><h1>Nhập mã OTP</h1><p class="auth-lead">Mã xác nhận đã được gửi đến <strong style="color:var(--text-soft)"><c:out value="${sessionScope.otpEmail}"/></strong> và có hiệu lực trong 5 phút.</p>
<c:if test="${not empty sessionScope.otpMessage}"><div class="alert alert-success" style="margin-bottom:14px"><c:out value="${sessionScope.otpMessage}"/></div><c:remove var="otpMessage" scope="session"/></c:if><c:if test="${not empty error}"><div class="alert alert-error" style="margin-bottom:14px"><c:out value="${error}"/></div></c:if>
<form class="auth-form" action="${pageContext.request.contextPath}/verify-otp" method="post"><div class="field"><label for="otp">Mã gồm 6 chữ số</label><input class="form-control otp-input" id="otp" name="otp" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autofocus autocomplete="one-time-code" placeholder="000000"></div><button class="btn btn-primary auth-submit" type="submit">Xác nhận OTP →</button></form>
<c:if test="${not empty sessionScope.otpDemoCode}"><div class="demo-otp">SMTP chưa được cấu hình nên ứng dụng đang ở chế độ demo.<br>Mã OTP: <strong class="mono"><c:out value="${sessionScope.otpDemoCode}"/></strong></div></c:if>
<form action="${pageContext.request.contextPath}/resend-otp" method="post"><button class="btn btn-ghost" style="width:100%;margin-top:10px" type="submit">Gửi lại mã OTP</button></form></div></main></body></html>
