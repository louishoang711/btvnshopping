<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><title>Sản phẩm</title></head><body><div class="store-container"><div class="store-toolbar"><div><p class="hero-eyebrow">Danh mục sản phẩm</p><h1 class="section-title">Tất cả sản phẩm</h1><p class="section-copy">${total} kết quả · hiển thị 6 sản phẩm mỗi trang</p></div><form class="catalog-filter" action="${pageContext.request.contextPath}/product" method="get"><input class="form-control" name="q" value="<c:out value='${q}'/>" placeholder="Tìm sản phẩm..."><select class="form-control" name="category"><option value="">Tất cả danh mục</option><c:forEach items="${categories}" var="cate"><option value="${cate.categoryId}" ${selectedCategory == cate.categoryId ? 'selected' : ''}><c:out value="${cate.categoryname}"/></option></c:forEach></select><button class="btn btn-primary" type="submit">Tìm kiếm</button></form></div>
<div class="product-grid six-page"><c:choose><c:when test="${empty products}"><div class="panel empty-state" style="grid-column:1/-1">Không tìm thấy sản phẩm phù hợp.</div></c:when><c:otherwise><c:forEach items="${products}" var="product"><article class="product-card"><a href="${pageContext.request.contextPath}/product/detail?id=${product.productId}"><div class="product-media"><c:choose><c:when test="${not empty product.images && product.images.startsWith('http')}"><img src="${product.images}" alt="<c:out value='${product.productName}'/>" loading="lazy"></c:when><c:when test="${not empty product.images}"><img src="${pageContext.request.contextPath}/image?fname=${product.images}" alt="<c:out value='${product.productName}'/>" loading="lazy" onerror="this.style.display='none'"></c:when><c:otherwise><span class="product-placeholder">P-${product.productId}</span></c:otherwise></c:choose></div><div class="product-card-body"><span class="product-category"><c:out value="${product.category.categoryname}"/></span><h2 class="product-name"><c:out value="${product.productName}"/></h2><div class="product-meta"><span class="product-price"><fmt:formatNumber value="${product.price}" type="number" maxFractionDigits="0"/>₫</span><span class="product-stock">${product.quantity > 0 ? product.quantity : 'Hết'} sp</span></div></div></a></article></c:forEach></c:otherwise></c:choose></div>
<c:if test="${totalPages > 1}"><nav class="pagination" aria-label="Phân trang"><c:forEach begin="1" end="${totalPages}" var="p"><c:url var="pageUrl" value="/product"><c:param name="page" value="${p}"/><c:if test="${not empty q}"><c:param name="q" value="${q}"/></c:if><c:if test="${not empty selectedCategory}"><c:param name="category" value="${selectedCategory}"/></c:if></c:url><a class="page-link ${p == page ? 'active' : ''}" href="${pageUrl}">${p}</a></c:forEach></nav></c:if>
</div></body></html>
