<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><title>Trang chủ</title></head><body>
<c:if test="${not empty sessionScope.storeMessage}"><div class="store-container" style="padding-top:18px"><div class="alert alert-error"><c:out value="${sessionScope.storeMessage}"/></div></div><c:remove var="storeMessage" scope="session"/></c:if>
<section class="store-hero"><div class="store-container hero-grid"><div><p class="hero-eyebrow">Cửa hàng sinh viên HCMUTE</p><h1 class="hero-title">Sản phẩm mới.<br><span>Trải nghiệm tốt hơn.</span></h1><p class="hero-copy">Khám phá những sản phẩm mới nhất vừa được cập nhật trên HCMUTE Shop. Danh mục rõ ràng, thông tin chi tiết và trải nghiệm mua sắm tối giản.</p><div class="hero-actions"><a class="btn btn-primary" href="${pageContext.request.contextPath}/product">Xem tất cả sản phẩm →</a><c:if test="${empty sessionScope.account}"><a class="btn" href="${pageContext.request.contextPath}/register">Tạo tài khoản</a></c:if></div></div><div class="hero-card"><div class="hero-card-top"><div><div class="hero-card-label">Sản phẩm đang hiển thị</div><div class="hero-card-price">${latestProducts.size()}</div></div><span class="status status-active">Mới nhất</span></div><div class="mini-bars" aria-hidden="true"><i style="height:34%"></i><i style="height:48%"></i><i style="height:42%"></i><i style="height:64%"></i><i style="height:58%"></i><i style="height:82%"></i><i style="height:76%"></i></div></div></div></section>
<section class="store-section"><div class="store-container"><div class="section-head"><div><h2 class="section-title">10 sản phẩm mới nhất</h2><p class="section-copy">Sắp xếp theo thời gian tạo mới nhất trong cơ sở dữ liệu.</p></div><a class="panel-action" href="${pageContext.request.contextPath}/product">Xem toàn bộ →</a></div>
<div class="product-grid"><c:choose><c:when test="${empty latestProducts}"><div class="panel empty-state" style="grid-column:1/-1">Chưa có sản phẩm. Quản trị viên hãy đăng nhập để thêm dữ liệu.</div></c:when><c:otherwise><c:forEach items="${latestProducts}" var="product"><article class="product-card"><a href="${pageContext.request.contextPath}/product/detail?id=${product.productId}"><div class="product-media"><c:choose><c:when test="${not empty product.images && product.images.startsWith('http')}"><img src="${product.images}" alt="<c:out value='${product.productName}'/>" loading="lazy"></c:when><c:when test="${not empty product.images}"><img src="${pageContext.request.contextPath}/image?fname=${product.images}" alt="<c:out value='${product.productName}'/>" loading="lazy" onerror="this.style.display='none'"></c:when><c:otherwise><span class="product-placeholder">P-${product.productId}</span></c:otherwise></c:choose><span class="product-tag">NEW</span></div><div class="product-card-body"><span class="product-category"><c:out value="${product.category.categoryname}"/></span><h3 class="product-name"><c:out value="${product.productName}"/></h3><div class="product-meta"><span class="product-price"><fmt:formatNumber value="${product.price}" type="number" maxFractionDigits="0"/>₫</span><span class="product-stock">${product.quantity > 0 ? product.quantity : 'Hết'} sp</span></div></div></a></article></c:forEach></c:otherwise></c:choose></div>
</div></section></body></html>
