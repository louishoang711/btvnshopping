<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><title><c:out value="${product.productName}"/></title></head><body><section class="product-detail"><div class="store-container"><a class="auth-link" href="${pageContext.request.contextPath}/product">← Tất cả sản phẩm</a><div class="detail-grid" style="margin-top:20px"><div class="detail-media"><c:choose><c:when test="${not empty product.images && product.images.startsWith('http')}"><img src="${product.images}" alt="<c:out value='${product.productName}'/>"></c:when><c:when test="${not empty product.images}"><img src="${pageContext.request.contextPath}/image?fname=${product.images}" alt="<c:out value='${product.productName}'/>" onerror="this.style.display='none'"></c:when><c:otherwise><span class="product-placeholder">P-${product.productId}</span></c:otherwise></c:choose></div><div class="detail-content"><p class="hero-eyebrow"><c:out value="${product.category.categoryname}"/> · P-${product.productId}</p><h1 class="detail-title"><c:out value="${product.productName}"/></h1><p class="detail-price"><fmt:formatNumber value="${product.price}" type="number" maxFractionDigits="0"/>₫</p><p class="detail-description"><c:out value="${empty product.description ? 'Sản phẩm chưa có mô tả chi tiết.' : product.description}"/></p><div class="detail-facts"><div class="detail-fact"><span>Danh mục</span><strong><c:out value="${product.category.categoryname}"/></strong></div><div class="detail-fact"><span>Tình trạng</span><strong>${product.quantity > 0 ? 'Còn hàng' : 'Hết hàng'}</strong></div><div class="detail-fact"><span>Số lượng trong kho</span><strong class="mono">${product.quantity}</strong></div><div class="detail-fact"><span>Trạng thái</span><span class="status status-active">Đang bán</span></div></div><div class="hero-actions"><a class="btn btn-primary" href="${pageContext.request.contextPath}/product">Tiếp tục mua sắm →</a></div></div></div></div></section></body></html>
